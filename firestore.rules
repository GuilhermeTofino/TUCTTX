rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // ENVIRONMENTS ROOT (Separation of DEV vs PROD)
    // =========================================================================
    match /environments/{env} {
      // Validate env is 'dev' or 'prod' if needed, or just allow wildcard.
      
      match /tenants/{tenantId} {
        // 1. Tenant Configuration
        // Public read access allowed for the app to load theme/config before login.
        allow read: if true;

        // -----------------------------------------------------------------------
        // HELPERS
        // -----------------------------------------------------------------------
        // Perfil de quem faz a requisição, dentro deste tenant.
        function me() {
          return get(/databases/$(database)/documents/environments/$(env)/tenants/$(tenantId)/users/$(request.auth.uid)).data;
        }

        // Pertence a ESTE tenant: tem perfil em users/ deste mesmo caminho. O projeto
        // Firebase é um só para todos os tenants, então sem isso qualquer usuário
        // logado leria os dados de outro tenant só trocando o caminho.
        function inTenant() {
          return request.auth != null &&
            exists(/databases/$(database)/documents/environments/$(env)/tenants/$(tenantId)/users/$(request.auth.uid));
        }

        function isAdmin() {
          return request.auth != null && me().role == 'admin';
        }

        // Membro = 'user' ou 'admin'. Visitante ('visitor') só vê o calendário.
        function isMember() {
          return request.auth != null && me().role in ['user', 'admin'];
        }

        // Admin tem todas as skills; 'user' precisa da skill na própria lista.
        // Visitante nunca tem skill. (Skill keys: ver PermissionService no app.)
        function hasSkill(key) {
          return request.auth != null &&
            (me().role == 'admin' ||
              (me().role == 'user' && key in me().get('skills', [])));
        }

        // Admin que consta na lista de aprovadores do financeiro.
        // Lista em: .../settings/finance -> approverIds (array de uid).
        function isFinanceApprover() {
          return isAdmin() &&
            request.auth.uid in get(/databases/$(database)/documents/environments/$(env)/tenants/$(tenantId)/settings/finance).data.get('approverIds', []);
        }

        // -----------------------------------------------------------------------
        // USERS SUBCOLLECTION
        // Path: /environments/{env}/tenants/{tenantId}/users/{userId}
        // -----------------------------------------------------------------------
        match /users/{userId} {
          // Leitura: o próprio documento sempre (o login precisa saber se o perfil
          // existe neste tenant); os dos outros, só quem pertence ao tenant.
          allow read: if request.auth != null &&
            (request.auth.uid == userId || inTenant());

          // Cadastro: só do próprio uid e sem se conceder skills.
          //  - app novo cria como 'visitor' (status 'active');
          //  - versões antigas do app nas lojas criam como 'user' (sem status/skills);
          //  - só admin cria com outro papel ou em nome de outra pessoa.
          allow create: if request.auth != null && (
            isAdmin() ||
            (request.auth.uid == userId &&
              request.resource.data.get('skills', []) == [] &&
              ((request.resource.data.get('role', 'user') == 'visitor' &&
                  request.resource.data.get('status', 'active') == 'active') ||
                request.resource.data.get('role', 'user') == 'user')));

          // Atualização: admin altera qualquer campo (papel, skills, status).
          // O próprio usuário edita dados pessoais, mas nunca role, skills nem
          // status. get() com padrão porque documentos antigos não têm skills/status.
          allow update: if request.auth != null && (
            isAdmin() ||
            (request.auth.uid == userId &&
              request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
              request.resource.data.get('skills', []) == resource.data.get('skills', []) &&
              request.resource.data.get('status', 'active') == resource.data.get('status', 'active')) ||
            // Visitante pede aprovação: única mudança de status que o próprio
            // usuário faz (active -> pending_approval), sem tocar em papel/skills.
            (request.auth.uid == userId &&
              resource.data.get('role', 'user') == 'visitor' &&
              request.resource.data.get('role', 'user') == 'visitor' &&
              request.resource.data.get('skills', []) == resource.data.get('skills', []) &&
              resource.data.get('status', 'active') == 'active' &&
              request.resource.data.get('status', 'active') == 'pending_approval') ||
            // Moderação de entidades: quem tem a skill altera SÓ o campo 'entities'.
            (hasSkill('entidades.moderar') &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entities'])));

          allow delete: if request.auth != null && request.auth.uid == userId;

          // Dados sensíveis (saúde): só o dono grava; dono e admins leem. Ficam
          // fora do documento do usuário, que qualquer membro logado consegue ler.
          match /private/{docId} {
            allow read: if request.auth != null &&
              (request.auth.uid == userId || isAdmin());
            allow write: if request.auth != null && request.auth.uid == userId;
          }
        }

        // -----------------------------------------------------------------------
        // AUDIT LOG (mudanças de papel/skills) e CATÁLOGO DE SKILLS — só admin.
        // O log só aceita 'undone' como alteração; nunca é apagado.
        // -----------------------------------------------------------------------
        match /audit_log/{logId} {
          allow read: if isAdmin();
          allow create: if isAdmin() &&
            request.resource.data.actorId == request.auth.uid;
          allow update: if isAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undone']);
          allow delete: if false;
        }

        match /skills_catalog/{skillId} {
          allow read, write: if isAdmin();
        }

        // -----------------------------------------------------------------------
        // SETTINGS SUBCOLLECTION
        // Path: .../settings/{docId}   (ex.: settings/finance -> approverIds)
        // -----------------------------------------------------------------------
        match /settings/{docId} {
          allow read: if inTenant();
          allow write: if isAdmin();
        }

        // -----------------------------------------------------------------------
        // PAYMENT REQUESTS (comprovantes de mensalidade aguardando aprovacao)
        // Path: .../payment_requests/{requestId}
        // O membro cria e le as proprias; apenas aprovadores decidem, nunca a propria.
        // A baixa em monthly_fees continua exigindo role admin (regra abaixo).
        // -----------------------------------------------------------------------
        match /payment_requests/{requestId} {
          allow read: if request.auth != null &&
            (resource.data.userId == request.auth.uid || isFinanceApprover());
          allow create: if isMember() &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.status == 'pending_approval';
          allow update: if isFinanceApprover() &&
            resource.data.userId != request.auth.uid &&
            request.resource.data.userId == resource.data.userId;
          allow delete: if false;
        }
        
        // -----------------------------------------------------------------------
        // MENUS SUBCOLLECTION
        // Path: .../menus/{menuId}
        // -----------------------------------------------------------------------
        match /menus/{menuId} {
          allow read: if inTenant();
          allow write: if request.auth != null && 
            get(/databases/$(database)/documents/environments/$(env)/tenants/$(tenantId)/users/$(request.auth.uid)).data.role == 'admin';
        }

        // -----------------------------------------------------------------------
        // ANNOUNCEMENTS SUBCOLLECTION
        // Path: .../announcements/{announcementId}
        // -----------------------------------------------------------------------
        match /announcements/{announcementId} {
          allow read: if isMember();
          allow write: if hasSkill('mural.publicar');
        }

        // -----------------------------------------------------------------------
        // FINANCIAL SUBCOLLECTION
        // Path: .../financial/{userId}
        // -----------------------------------------------------------------------
        match /financial/{userId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId || hasSkill('financeiro.gerenciar'));

          match /monthly_fees/{feeId} {
            allow read: if request.auth != null &&
              (request.auth.uid == userId || hasSkill('financeiro.gerenciar'));
            allow write: if hasSkill('financeiro.gerenciar');
          }

          match /bazaar_debts/{debtId} {
            allow read: if request.auth != null &&
              (request.auth.uid == userId ||
                hasSkill('bazar.gerenciar') || hasSkill('financeiro.gerenciar'));
            allow write: if hasSkill('bazar.gerenciar');
          }
        }

        // -----------------------------------------------------------------------
        // FINANCIAL GOALS SUBCOLLECTION
        // Path: .../financial_goals/{goalId}
        // -----------------------------------------------------------------------
        match /financial_goals/{goalId} {
          allow read, write: if hasSkill('financeiro.gerenciar');
        }

        // -----------------------------------------------------------------------
        // EVENTS SUBCOLLECTION
        // Path: .../events/{eventId}
        // -----------------------------------------------------------------------
        match /events/{eventId} {
          // Visitante enxerga o calendário; o resto é de membros.
          allow read: if inTenant();
          allow write: if hasSkill('calendario.gerenciar');
          // Faxina: quem tem a skill altera SÓ escala e presença de faxina.
          allow update: if hasSkill('limpeza.gerenciar') &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['cleaningCrew', 'confirmedAttendance', 'updatedAt']);

          match /confirmations/{userId} {
            allow read: if inTenant();
            allow write: if isMember() && request.auth.uid == userId;
          }
        }

        // -----------------------------------------------------------------------
        // STUDIES SUBCOLLECTION
        // Path: .../studies/{docId}
        // -----------------------------------------------------------------------
        match /studies/{docId} {
          allow read: if isMember();
          allow write: if hasSkill('estudos.gerenciar');
        }
        // -----------------------------------------------------------------------
        // CAMBONE SCHEDULES SUBCOLLECTION
        // Path: .../cambone_schedules/{scheduleId}
        // -----------------------------------------------------------------------
        match /cambone_schedules/{scheduleId} {
          allow read: if true;
          allow write: if hasSkill('calendario.gerenciar');
        }
      }
    }
    
    // =========================================================================
    // LEGACY / DEPRECATED PATHS
    // =========================================================================
    // Blocking access to root /events to ensure data consistency with the new structure.
    match /events/{eventId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // NOTIFICATIONS QUEUE (Triggers for Cloud Functions)
    // -----------------------------------------------------------------------
    match /notifications_queue/{docId} {
      // Permite criar apenas se o usuário estiver logado e for admin no tenant/env especificado
      // Admin, ou membro com a skill 'notificacoes.enviar' (no tenant/env do doc).
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/environments/$(request.resource.data.env)/tenants/$(request.resource.data.tenantId)/users/$(request.auth.uid)).data.role == 'admin' ||
        (get(/databases/$(database)/documents/environments/$(request.resource.data.env)/tenants/$(request.resource.data.tenantId)/users/$(request.auth.uid)).data.role == 'user' &&
          'notificacoes.enviar' in get(/databases/$(database)/documents/environments/$(request.resource.data.env)/tenants/$(request.resource.data.tenantId)/users/$(request.auth.uid)).data.get('skills', [])));
      
      // Proíbe leitura, update ou delete pelo app (apenas Cloud Functions devem gerenciar)
      allow read, update, delete: if false;
    }
  }
}
