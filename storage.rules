rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Nova estrutura: /environments/{env}/tenants/{tenantId}/profiles/{userId}
    match /environments/{env}/tenants/{tenantId}/profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Estrutura de Estudos: /environments/{env}/tenants/{tenantId}/studies/{topicId}/{fileName}
    // Leitura: membros (visitante não acessa). Escrita: admin ou skill 'estudos.gerenciar'.
    match /environments/{env}/tenants/{tenantId}/studies/{topicId}/{fileName} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/environments/$(env)/tenants/$(tenantId)/users/$(request.auth.uid)).data.role in ['user', 'admin'];
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/environments/$(env)/tenants/$(tenantId)/users/$(request.auth.uid)).data.role == 'admin' ||
        (firestore.get(/databases/(default)/documents/environments/$(env)/tenants/$(tenantId)/users/$(request.auth.uid)).data.role == 'user' &&
          'estudos.gerenciar' in firestore.get(/databases/(default)/documents/environments/$(env)/tenants/$(tenantId)/users/$(request.auth.uid)).data.get('skills', [])));
    }

    // Comprovantes de mensalidade:
    // /environments/{env}/tenants/{tenantId}/receipts/{year}/{userId}/{requestId}
    // Leitura: dono e aprovadores do financeiro (settings/finance -> approverIds).
    // Escrita: apenas o dono, sem sobrescrever; imagem/PDF de ate 5 MB.
    // Remocao anual: Cloud Function (Admin SDK), nunca o app.
    match /environments/{env}/tenants/{tenantId}/receipts/{year}/{userId}/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid in firestore.get(/databases/(default)/documents/environments/$(env)/tenants/$(tenantId)/settings/finance).data.get('approverIds', [])
      );
      // 'resource == null' = o objeto ainda não existe: reenviar por cima (trocar a
      // prova depois do envio) é negado, sem depender de como o método é inferido.
      allow create: if resource == null &&
        request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }
  }
}
